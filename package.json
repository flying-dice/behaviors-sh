{
  "name": "behaviors-sh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "trees/*"
  ],
  "scripts": {
    "dev:client": "bun --filter @behaviors-sh/client dev",
    "dev:server": "bun --filter @behaviors-sh/server dev",
    "dev": "bun --filter '*' --parallel dev",
    "build": "bun --filter @behaviors-sh/client build",
    "start": "bun --filter @behaviors-sh/server start",
    "cli": "bun --filter @behaviors-sh/cli start",
    "cli:headless": "bun --filter @behaviors-sh/cli headless",
    "compile": "bun --filter @behaviors-sh/cli compile",
    "check": "bun --filter @behaviors-sh/client check"
  }
}
