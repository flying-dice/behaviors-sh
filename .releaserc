{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/flying-dice/behaviors-sh.git",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "breaking": true, "release": "minor" },
          { "type": "feat",  "release": "minor" },
          { "type": "fix",   "release": "minor" },
          { "type": "perf",  "release": "minor" },
          { "type": "revert", "release": "minor" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here. Versions follow [semantic versioning](https://semver.org/); the release notes are generated from conventional commit messages by semantic-release."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "set -e; for f in packages/spec/package.json packages/dsl/package.json packages/cli/package.json; do sed -i.bak -E 's/\"version\": \"[^\"]+\"/\"version\": \"${nextRelease.version}\"/' \"$f\"; done && rm -f packages/*/package.json.bak && bun --filter @behaviors-sh/spec build && bun --filter @behaviors-sh/dsl build && bun --filter @behaviors-sh/cli build",
        "publishCmd": "set -e; (cd packages/spec && bun publish --access=public); (cd packages/dsl && bun publish --access=public); (cd packages/cli && bun publish --access=public); git add CHANGELOG.md packages/spec/package.json packages/dsl/package.json packages/cli/package.json; git commit -m 'chore(release): ${nextRelease.version} [skip ci]'; git tag -fa 'v${nextRelease.version}' -m 'v${nextRelease.version}'; git push origin HEAD:main --follow-tags; git push github HEAD:main --follow-tags"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
