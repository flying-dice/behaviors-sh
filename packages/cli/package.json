{
	"name": "@behaviors-sh/cli",
	"version": "0.0.0",
	"description": "Behaviour-tree runtime CLI — exposes the runtime over MCP (STDIO or HTTP).",
	"type": "module",
	"bin": {
		"behaviors-sh": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"build": "bun scripts/build.ts",
		"prepublishOnly": "bun scripts/build.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@behaviors-sh/runtime": "workspace:*",
		"@hono/mcp": "^0.2.5",
		"@hono/node-server": "^1.13.4",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"commander": "^14.0.3",
		"hono": "^4.12.18",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "~6.0.2"
	}
}
