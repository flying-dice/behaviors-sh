# Playwright test output
test-results/
playwright-report/

# Behaviour-tree runtime artefacts (executions + materialised trees).
# These are generated by the runtime / dev scripts and live under the
# directory chosen by the agent's `traceOutput` URI — committing them
# would leak per-run data.
.behaviors-sh/
# Legacy artefact dir from the pre-rename behaviors-ui name. Kept on
# disk so saved workspaces aren't lost; ignored so we don't commit them.
.behaviors-ui/
/docs/.vitepress/dist/
/docs/.vitepress/cache/
